{
  "name": "paraglide-the-world",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "world-data:build": "pnpm --filter @wilder-future/world-data-engine build",
    "dev": "pnpm world-data:build && pnpm --filter @paraglide-the-world/web dev",
    "build": "pnpm world-data:build && pnpm --filter @paraglide-the-world/web build",
    "lint": "pnpm --filter @paraglide-the-world/web lint",
    "test": "pnpm --filter @wilder-future/world-data-engine test && pnpm --filter @paraglide-the-world/web test"
  }
}
